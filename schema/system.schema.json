{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/system.schema.json",
  "title": "Software Supply Chain System Representation",
  "description": "Schema ustrukturyzowanej reprezentacji łańcucha dostaw oprogramowania wykorzystywanej jako wejście procesu modelowania zagrożeń.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "metadata",
    "elements",
    "relationships",
    "flows"
  ],

  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },

    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/component"
          },
          {
            "$ref": "#/$defs/process"
          },
          {
            "$ref": "#/$defs/resource"
          },
          {
            "$ref": "#/$defs/trustBoundary"
          }
        ]
      }
    },

    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },

    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    }
  },

  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "title",
        "version",
        "date",
        "description",
        "authors",
        "organization"
      ],

      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string",
          "minLength": 1
        },

        "date": {
          "type": "string",
          "format": "date"
        },

        "description": {
          "type": "string",
          "minLength": 1
        },

        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "organization": {
          "type": "string"
        }
      }
    },

    "component": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "name",
        "description",
        "ownership",
        "exposure"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "const": "component"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        },

        "technology": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string",
          "minLength": 1
        },

        "identifiers": {
          "$ref": "#/$defs/identifiers"
        },

        "ownership": {
          "type": "string",
          "enum": [
            "internal",
            "external",
            "third_party"
          ]
        },

        "owner": {
          "type": "string",
          "minLength": 1
        },

        "exposure": {
          "type": "string",
          "enum": [
            "internet_facing",
            "internal",
            "restricted",
            "not_networked",
            "unknown"
          ]
        },

        "environment": {
          "type": "string",
          "enum": [
            "development",
            "testing",
            "staging",
            "production",
            "shared",
            "unknown"
          ]
        },

        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },

        "security_controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/securityControl"
          }
        }
      }
    },

    "identifiers": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "cpe": {
          "type": "string",
          "minLength": 1
        },

        "purl": {
          "type": "string",
          "minLength": 1
        }
      },

      "minProperties": 1
    },

    "interface": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "name",
        "protocol"
      ],

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "protocol": {
          "type": "string",
          "minLength": 1
        },

        "authentication": {
          "$ref": "#/$defs/authentication"
        }
      }
    },

    "authentication": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "required"
      ],

      "properties": {
        "required": {
          "type": "boolean"
        },

        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },

    "securityControl": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "type",
        "description"
      ],

      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "process": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "name",
        "description"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "const": "process"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "resource": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "const": "resource"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "const": "trust_boundary"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "relationship": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source",
        "target",
        "type"
      ],

      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },

        "target": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "flow": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source",
        "target",
        "data_type"
      ],

      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },

        "target": {
          "type": "string",
          "minLength": 1
        },

        "data_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}